# ─── GitHub ──────────────────────────────────────────────────────────────────
# Get free token at: https://github.com/settings/tokens → Generate new token (classic)
# Scopes needed: repo (read-only is fine for public repos)
GITHUB_TOKEN=ghp_your_token_here
GITHUB_WEBHOOK_SECRET=your_webhook_hmac_secret_here

# ─── LLM Provider (pick ONE) ─────────────────────────────────────────────────
# Option A — Groq (FREE, recommended for Phase 1 proof)
# Get free key at: https://console.groq.com → Create API Key
GROQ_API_KEY=gsk_your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Option B — OpenAI (paid, ~$1-2 for 50 PRs)
OPENAI_API_KEY=sk-your_openai_key_here
OPENAI_MODEL=gpt-4o

# Option C — Gemini (FREE, highly recommended)
# Get free key at: https://aistudio.google.com/ → Create API Key
GEMINI_API_KEY=AIzaSy_your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash

# Which provider to use: "groq", "openai", or "gemini"
LLM_PROVIDER=gemini

# ─── Ledger ──────────────────────────────────────────────────────────────────
# Path to the append-only JSONL ledger file (Phase 1 uses flat file, Phase 2 uses Postgres)
LEDGER_PATH=./data/tesson_ledger.jsonl

# ─── TERL ────────────────────────────────────────────────────────────────────
# Path to the entity resolution ledger JSON (auto-created on first run)
TERL_PATH=./data/terl_ledger.json

# ─── Postgres (Phase 2 — leave blank for Phase 1) ────────────────────────────
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/tesson
